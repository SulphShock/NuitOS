-- ai_agents_secrets.lua.example
--
-- Copy this file to `ai_agents_secrets.lua` (same folder) and fill in your
-- real keys. `ai_agents.lua` loads it automatically if it exists.
--
--   cp ai_agents_secrets.lua.example ai_agents_secrets.lua
--
-- IMPORTANT: add `lua/ai_agents_secrets.lua` to your .gitignore before you
-- ever commit this dotfiles repo (see the snippet at the bottom of this
-- file). The `.example` file is safe to commit; the real one is not.
--
-- You only need to set the keys for the agents/providers you actually use.
-- Anything you leave out here just falls back to whatever's already in
-- your shell environment (e.g. exported in .zshrc) — this file only
-- overrides/adds on top, it doesn't replace your normal env.

return {
  claude = {
    env = {
      -- ANTHROPIC_API_KEY = "sk-ant-...",
    },
  },

  opencode = {
    env = {
      -- opencode can use several providers depending on which --model you pass
      -- ANTHROPIC_API_KEY = "sk-ant-...",
      -- OPENAI_API_KEY = "sk-...",
      -- GOOGLE_API_KEY = "...",
      -- MOONSHOT_API_KEY = "...",
    },
  },

  kimi = {
    env = {
      -- MOONSHOT_API_KEY = "...",
    },
  },
}

--[[
Add this line to .gitignore in your nvim config repo:

  lua/ai_agents_secrets.lua
]]
