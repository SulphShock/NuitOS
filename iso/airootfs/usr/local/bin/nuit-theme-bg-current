#!/bin/bash
# Prints today's background. that's it, that's the script.
# nuit-theme-bg-current — print the current background path
# Usage: nuit-theme-bg-current
set -euo pipefail
LINK="$HOME/.config/nuit/current/background"
if [ -L "$LINK" ]; then
  readlink -f "$LINK"
elif [ -f "$LINK" ]; then
  cat "$LINK"
else
  echo "No background set (run nuit-theme-bg-next)" >&2
  exit 1
fi
