#!/bin/bash
# nuit-capture-menu — Nuit capture menu (Super+Ctrl+C)
# fuzzel picker over screenshot / record / extract / color actions.
set -euo pipefail

need() {  # need <binary> <install-hint>
  if ! command -v "$1" >/dev/null 2>&1; then
    notify-send -a Nuit "Missing: $1" "$2" 2>/dev/null || true
    echo "Missing: $1 — $2" >&2
    exit 1
  fi
}

latest_shot() {
  local dir="${NUIT_SCREENSHOT_DIR:-$HOME/Pictures}"
  ls -t "$dir"/screenshot-*.png 2>/dev/null | head -n1 || true
}

annotate_last() {
  local shot editor
  shot="$(latest_shot)"
  [ -n "$shot" ] || { notify-send -a Nuit "Nothing to annotate" "Take a screenshot first" 2>/dev/null || true; exit 0; }
  editor="${NUIT_SCREENSHOT_EDITOR:-}"
  if [ -z "$editor" ]; then
    if command -v swappy >/dev/null 2>&1; then editor="swappy -f"
    else
      notify-send -a Nuit "No annotation editor" "Install swappy: sudo pacman -S swappy" 2>/dev/null || true
      echo "Install an editor: sudo pacman -S swappy" >&2
      exit 1
    fi
  fi
  # shellcheck disable=SC2086
  exec $editor "$shot"
}

ocr_region() {
  need tesseract "install: tesseract + tesseract-data-eng"
  local geo tmp text
  geo="$(slurp 2>/dev/null)" || exit 0
  [ -n "$geo" ] || exit 0
  tmp="$(mktemp /tmp/nuit-ocr-XXXXXX.png)"
  trap 'rm -f "$tmp"' EXIT
  grim -g "$geo" "$tmp"
  text="$(tesseract "$tmp" stdout 2>/dev/null | tr -d '\f' | sed '/^[[:space:]]*$/d')"
  if [ -n "$text" ]; then
    printf '%s' "$text" | wl-copy 2>/dev/null || exit 1
    notify-send -a Nuit "Text extracted to clipboard" "$(printf '%s' "$text" | head -c 120)" 2>/dev/null || true
  else
    notify-send -a Nuit "No text found" "Try a larger, sharper region" 2>/dev/null || true
  fi
}

qr_region() {
  need zbarimg "install: zbar"
  local geo tmp code
  geo="$(slurp 2>/dev/null)" || exit 0
  [ -n "$geo" ] || exit 0
  tmp="$(mktemp /tmp/nuit-qr-XXXXXX.png)"
  trap 'rm -f "$tmp"' EXIT
  grim -g "$geo" "$tmp"
  code="$(zbarimg --raw --quiet "$tmp" 2>/dev/null | head -n1 || true)"
  if [ -n "$code" ]; then
    printf '%s' "$code" | wl-copy 2>/dev/null || exit 1
    notify-send -a Nuit "QR code copied" "(value hidden — paste to use)" 2>/dev/null || true
  else
    notify-send -a Nuit "No QR code found" "Try a tighter crop" 2>/dev/null || true
  fi
}

play_last_recording() {
  local dir="${NUIT_SCREENRECORD_DIR:-$HOME/Videos}"
  local last
  last="$(ls -t "$dir"/screenrecording-*.mp4 2>/dev/null | head -n1 || true)"
  [ -n "$last" ] || { notify-send -a Nuit "No recordings" "Super+Ctrl+C to record one" 2>/dev/null || true; exit 0; }
  need mpv "install: mpv"
  exec mpv "$last" >/dev/null 2>&1 &
}

CHOICE="$(printf '%s\n' \
  "Screenshot: region (save + clipboard)" \
  "Screenshot: window (save + clipboard)" \
  "Screenshot: fullscreen (save + clipboard)" \
  "Screenshot: region (clipboard only)" \
  "Annotate last screenshot" \
  "Record screen (toggle)" \
  "Play last recording" \
  "Extract text from region (OCR)" \
  "Scan QR code from region" \
  "Pick color (copy hex)" \
  "Open screenshots folder" \
  | fuzzel --dmenu -p "Capture: " 2>/dev/null || true)"

case "$CHOICE" in
  "Screenshot: region (save + clipboard)") exec nuit-screenshot region both ;;
  "Screenshot: window (save + clipboard)") exec nuit-screenshot window both ;;
  "Screenshot: fullscreen (save + clipboard)") exec nuit-screenshot fullscreen both ;;
  "Screenshot: region (clipboard only)") exec nuit-screenshot region copy ;;
  "Annotate last screenshot") annotate_last ;;
  "Record screen (toggle)") exec nuit-screenrecord region ;;
  "Play last recording") play_last_recording ;;
  "Extract text from region (OCR)") ocr_region ;;
  "Scan QR code from region") qr_region ;;
  "Pick color (copy hex)") exec hyprpicker -a -n ;;
  "Open screenshots folder")
    DIR="${NUIT_SCREENSHOT_DIR:-$HOME/Pictures}"
    mkdir -p "$DIR"
    if command -v nautilus >/dev/null 2>&1; then exec nautilus "$DIR" >/dev/null 2>&1 &
    else exec xdg-open "$DIR" >/dev/null 2>&1 & fi
    ;;
  *) exit 0 ;;  # dismissed
esac
