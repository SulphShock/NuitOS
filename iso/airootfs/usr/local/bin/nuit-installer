#!/bin/bash
# nuit-installer — NuitOS disk installer
#
# Phase 1 (gum TUI): disk, filesystem, swap, LUKS, locale, keymap, timezone,
#                    user, hostname, summary.
# Phase 2 (root, non-interactive): partition + format, pacstrap the NuitOS
#                    package list, chroot theming (skel, SDDM,
#                    systemd-boot, locale, time, user) and clean first boot.
#
# UEFI only (systemd-boot). Run `nuit-installer --dry-run` to print the plan
# without modifying a single byte.

set -euo pipefail

# ── Gruvbox Dark Hard palette ────────────────────────────────────────────────
readonly BG3="#3c3836"
readonly FG="#ebdbb2"
readonly DIM="#7c6f64"
readonly ACCENT="#d79921"
readonly GREEN="#b8bb26"
readonly RED="#fb4934"

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

# Re-exec as root (live user has NOPASSWD sudo); keep the pretty UI.
if [[ $DRY_RUN -ne 1 && "$(id -u)" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

# ── Helpers ──────────────────────────────────────────────────────────────────
step_num=0
total_steps=8

step_header() {
  step_num=$1
  local label="$2"
  gum style \
    --padding "0 2" \
    --border rounded \
    --border-foreground "$ACCENT" \
    --foreground "$ACCENT" \
    --bold \
    " ${step_num}/${total_steps} — ${label} "
}

card() {
  gum style \
    --padding "0 3" \
    --border rounded \
    --border-foreground "$BG3" \
    --foreground "$FG" \
    --width 60 \
    "$@"
}

info()  { gum log --time "" --level info --foreground "$DIM" "  $1"; }
ok()    { gum log --time "" --level info --foreground "$GREEN" "  ✓ $1"; }
warn()  { gum log --time "" --level warn --foreground "$RED" "  ✗ $1"; }
fail()  { warn "$1"; exit 1; }
label() { gum style --foreground "$DIM" --bold "  $1"; }
input() { gum input --prompt "${ACCENT}▸ " --placeholder "$1"; }
pick()  { gum choose --cursor-prefix "${ACCENT} ▸ " --selected-prefix "${GREEN} ✓ " "$@"; }
filter() { gum filter --prompt "${ACCENT}▸ " "$@"; }

need() { command -v "$1" >/dev/null 2>&1 || fail "required tool not found: $1"; }
for tool in gum lsblk sgdisk jq pacstrap arch-chroot genfstab bootctl; do
  need "$tool"
done

# Reliable device naming for whole-disks like nvme0n1p1 / mmcblk0p1.
part_suffix() {
  if [[ "$1" =~ ^(nvme|mmcblk|loop) ]]; then
    echo p
  fi
  return 0
}

clear
echo

# ── Banner ───────────────────────────────────────────────────────────────────
gum style \
  --padding "1 4" \
  --border double \
  --border-foreground "$ACCENT" \
  --foreground "$ACCENT" \
  --bold \
  --align center \
  --width 60 \
  "NuitOS Installer"

gum style \
  --padding "0 4" \
  --foreground "$DIM" \
  --align center \
  --width 60 \
  "Arch Linux · Hyprland · Ghostty · Gruvbox"

echo

card "
${GREEN}Welcome.${FG}  This installer writes a fresh NuitOS system to a disk.

${RED}This will permanently erase the target disk.${DIM}  There is no undo —
back up anything you care about first.

You will be asked a few questions, then shown a summary
before anything is written."
[[ $DRY_RUN -eq 1 ]] && warn "dry-run mode: plan only, nothing will be modified"
echo

# ══════════════════════════════════════════════════════════════════════════════
#  Phase 1 — Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Disk ──────────────────────────────────────────────────────────────────
step_header 1 "Target Disk"
echo

DISKS_JSON="$(lsblk -J -o NAME,SIZE,MODEL,TYPE,TRAN,MOUNTPOINTS 2>/dev/null)"
DISK_LINES="$(jq -r '.blockdevices[] | select(.type=="disk") | "\(.name)\t\(.size)\t\(.model // "unknown")"' <<<"$DISKS_JSON")"
[[ -z "$DISK_LINES" ]] && fail "no disks found"

DISK_CHOICES="$(echo "$DISK_LINES" | awk -F'\t' '{printf "%-12s  %-10s  %s\n", $1, $2, $3}')"
DISK_LINE="$(echo "$DISK_CHOICES" | pick --header "  Select the target disk")"
DISK="$(echo "$DISK_LINE" | awk '{print $1}')"
DISK_DEV="/dev/$DISK"
[[ -e "$DISK_DEV" ]] || fail "invalid disk: $DISK_DEV"

MNTD="$(jq -r '.blockdevices[] | select(.name=="'"$DISK"'") | .mountpoints[]? // empty' <<<"$DISKS_JSON")"
[[ -n "$MNTD" ]] && fail "$DISK is mounted at $MNTD — unmount first"

ok "$DISK_DEV selected"
echo

# ── 2. Filesystem ────────────────────────────────────────────────────────────
step_header 2 "Filesystem"
echo

FS="$(pick --header "  Root filesystem" "ext4" "btrfs")"
case "$FS" in ext4|btrfs) : ;; *) fail "unsupported: $FS" ;; esac
ok "Root: $FS"
echo

# ── 3. Swap ──────────────────────────────────────────────────────────────────
step_header 3 "Swap"
echo

SWAP_OPT="$(pick --header "  Swap configuration" "none" "swap partition")"
SWAP_G=""
if [[ "$SWAP_OPT" == *"swap"* ]]; then
  RAM_GB=$(awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo)
  [[ "$RAM_GB" -lt 1 ]] && RAM_GB=1
  label "Swap size in GiB (default: ${RAM_GB} = RAM size)"
  SWAP_G="$(input "${RAM_GB}")"
  SWAP_G="${SWAP_G:-$RAM_GB}"
  (( SWAP_G > 128 )) && SWAP_G=128
  ok "Swap: ${SWAP_G}GiB"
else
  ok "Swap: none"
fi
echo

# ── 4. Encryption ────────────────────────────────────────────────────────────
step_header 4 "Encryption"
echo

LUKS_OPT="$(pick --header "  Disk encryption (LUKS2 on root)" "none" "full-disk encryption (LUKS2)")"
LUKS_PASS=""
if [[ "$LUKS_OPT" == *"LUKS2"* ]]; then
  LUKS_PASS="$(gum input --password --prompt "${ACCENT}▸ " --placeholder "encryption passphrase (min 8 chars)")"
  [[ ${#LUKS_PASS} -lt 8 ]] && fail "passphrase too short"
  RECHECK="$(gum input --password --prompt "${ACCENT}▸ " --placeholder "repeat passphrase")"
  [[ "$LUKS_PASS" != "$RECHECK" ]] && fail "passphrases do not match"
  ok "LUKS2 encryption enabled"
else
  ok "No encryption"
fi
echo

# ── 5. Locale / Keymap / Timezone ────────────────────────────────────────────
step_header 5 "Locale & Input"
echo

LOCALE="$(pick --header "  Locale" \
  "en_US.UTF-8 UTF-8" \
  "de_DE.UTF-8 UTF-8" \
  "fr_FR.UTF-8 UTF-8" \
  "es_ES.UTF-8 UTF-8" \
  "it_IT.UTF-8 UTF-8" \
  "pt_BR.UTF-8 UTF-8" \
  "nl_NL.UTF-8 UTF-8" \
  "pl_PL.UTF-8 UTF-8" \
  "ru_RU.UTF-8 UTF-8" \
  "ja_JP.UTF-8 UTF-8")"
LANG_VAL="${LOCALE%% *}"
ok "Locale: $LANG_VAL"

label "Keymap"
KEYMAP="$(filter --header "  Search keymaps" <<<"$(localectl list-keymaps 2>/dev/null)")"
[[ -z "$KEYMAP" ]] && KEYMAP="us"
ok "Keymap: $KEYMAP"

label "Timezone"
TZ="$(filter --header "  Search region/city" <<<"$(timedatectl list-timezones 2>/dev/null)")"
[[ -z "$TZ" ]] && TZ="Etc/UTC"
ok "Timezone: $TZ"
echo

# ── 6. User ──────────────────────────────────────────────────────────────────
step_header 6 "User Account"
echo

label "Full name"
FULL_NAME="$(input "Ada Nuit")"
label "Username (lowercase)"
USERNAME="$(input "ada")"
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid username: $USERNAME"

label "Password"
USER_PASS="$(gum input --password --prompt "${ACCENT}▸ " --placeholder "min 6 chars")"
[[ -z "$USER_PASS" || ${#USER_PASS} -lt 6 ]] && fail "password too short"
RECHECK="$(gum input --password --prompt "${ACCENT}▸ " --placeholder "repeat password")"
[[ "$USER_PASS" != "$RECHECK" ]] && fail "passwords do not match"

label "Hostname"
HOSTNAME="$(input "nuitos")"
[[ "$HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || HOSTNAME="nuitos"

ok "User: ${USERNAME} (${FULL_NAME:-$USERNAME})  host: ${HOSTNAME}"
echo

# ── 7. Summary ───────────────────────────────────────────────────────────────
step_header 7 "Review & Confirm"
echo

gum style \
  --padding "1 3" \
  --border rounded \
  --border-foreground "$ACCENT" \
  --width 60 \
  --foreground "$FG" \
"  ${ACCENT}Disk:${FG}       $DISK_DEV
  ${ACCENT}Filesystem:${FG} $FS  ${DIM}·${FG}  swap ${SWAP_G:-off}  ${DIM}·${FG}  ${LUKS_OPT}
  ${ACCENT}Locale:${FG}     ${LANG_VAL}  ${DIM}·${FG}  ${KEYMAP}  ${DIM}·${FG}  ${TZ}
  ${ACCENT}User:${FG}       ${USERNAME}  ${DIM}·${FG}  host ${HOSTNAME}"

echo

gum confirm \
  --affirmative "INSTALL" \
  --negative "Abort" \
  --selected.foreground "$GREEN" \
  --unselected.foreground "$DIM" \
  "Erase ${DISK_DEV} and install NuitOS?" || { warn "aborted"; exit 1; }

# ── 8. Dry-run exit ──────────────────────────────────────────────────────────
if [[ $DRY_RUN -eq 1 ]]; then
  step_header 8 "Dry-Run Plan"
  echo
  card "${GREEN}PLAN${DIM} (dry-run, no action taken)
  - sgdisk GPT on ${DISK_DEV}:
    ${P1}  ESP 512MiB (ef00)
    ${SWAP_G:+${DISK_DEV}${PS}2  swap ${SWAP_G}GiB (8200)}
    ${ROOT_PART}  root ${FS} ${LUKS_OPT:+LUKS2}
  - mount /mnt → root, ${P1} → /mnt/boot
  - pacstrap -K /mnt  \$(cat /usr/local/share/nuit/pkgs-disk.txt)
  - chroot: skel + user + hostname + locale/time/keymap
            + initramfs + systemd-boot (UEFI)"
  exit 0
fi

# ══════════════════════════════════════════════════════════════════════════════
#  Phase 2 — Installation
# ══════════════════════════════════════════════════════════════════════════════
step_header 8 "Installing NuitOS"
echo

[[ "$(id -u)" -eq 0 ]] || fail "phase 2 must run as root"
PKG_LIST=/usr/local/share/nuit/pkgs-disk.txt
[[ -s "$PKG_LIST" ]] || fail "missing package list: $PKG_LIST"
[[ -d /sys/firmware/efi ]] || fail "UEFI boot required"

PS="$(part_suffix "$DISK")"
P1="${DISK_DEV}${PS}1"

# ── Partition ────────────────────────────────────────────────────────────────
info "Creating GPT partition table on $DISK_DEV"
sgdisk --zap-all "$DISK_DEV" >/dev/null 2>&1 || true
sgdisk --new=1:0:+512M --typecode=1:ef00 --change-name=1:ESP "$DISK_DEV" >/dev/null
ROOT_IDX=2
ROOT_PART="${DISK_DEV}${PS}2"
SWAP_PART=""
if [[ -n "${SWAP_G:-}" ]] && (( SWAP_G > 0 )); then
  sgdisk --new=2:0:+"${SWAP_G}G" --typecode=2:8200 --change-name=2:swap "$DISK_DEV" >/dev/null
  SWAP_PART="${DISK_DEV}${PS}2"
  ROOT_IDX=3
  ROOT_PART="${DISK_DEV}${PS}3"
fi
case "$FS" in btrfs) ROOT_TYPE=8304 ;; *) ROOT_TYPE=8300 ;; esac
sgdisk --new="${ROOT_IDX}:0:-0" --typecode="${ROOT_IDX}:${ROOT_TYPE}" --change-name="${ROOT_IDX}:nuitroot" "$DISK_DEV" >/dev/null ||
  fail "partitioning failed on $DISK_DEV"
partprobe "$DISK_DEV" || true
sleep 1; udevadm settle || true
ok "Partitioned: ESP + ${SWAP_G:+swap + }root"

# ── Encryption ───────────────────────────────────────────────────────────────
TARGET="$ROOT_PART"
if [[ "$LUKS_OPT" == *"LUKS2"* ]]; then
  info "Formatting LUKS2 on $ROOT_PART"
  printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --batch-mode --type luks2 -q "$ROOT_PART" -
  printf '%s' "$LUKS_PASS" | cryptsetup open --type luks2 "$ROOT_PART" cryptroot -
  TARGET="/dev/mapper/cryptroot"
  ok "LUKS2 encrypted"
fi
ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"

# ── Filesystems ──────────────────────────────────────────────────────────────
info "Creating filesystems"
mkfs.fat -F32 -n ESP "$P1" >/dev/null
case "$FS" in
  btrfs) mkfs.btrfs -f -L NUITROOT "$TARGET" >/dev/null ;;
  *)     mkfs.ext4 -F -L NUITROOT "$TARGET" >/dev/null ;;
esac
if [[ -n "$SWAP_PART" ]]; then
  mkswap -L swap "$SWAP_PART" >/dev/null
  swapon "$SWAP_PART" >/dev/null
fi
ok "Filesystems ready: ${FS} root + FAT32 ESP${SWAP_G:+ + swap}"

# ── Mount ────────────────────────────────────────────────────────────────────
info "Mounting target"
mkdir -p /mnt/boot
mount "$TARGET" /mnt
mount "$P1" /mnt/boot
ok "Mounted /mnt"

# ── Pacstrap ─────────────────────────────────────────────────────────────────
mapfile -t PKGS < "$PKG_LIST"
[[ ${#PKGS[@]} -gt 0 ]] || fail "empty package list"
info "Installing ${#PKGS[@]} packages (this may take a while)"
gum spin --spinner dot --title "  pacstrap ${#PKGS[@]} packages…" -- \
  pacstrap -K /mnt "${PKGS[@]}"
ok "Packages installed"

# ── Fstab ────────────────────────────────────────────────────────────────────
info "Generating fstab"
genfstab -U /mnt >> /mnt/etc/fstab
ok "fstab written"

# ── Chroot stage 2 ──────────────────────────────────────────────────────────
info "Configuring system (chroot)"
LUKS_HOOK=""; [[ "$LUKS_OPT" == *"LUKS2"* ]] && LUKS_HOOK="encrypt"
ROOT_LINE="root=UUID=${ROOT_UUID} rw quiet"
[[ "$LUKS_OPT" == *"LUKS2"* ]] && ROOT_LINE="cryptdevice=UUID=${ROOT_UUID}:cryptroot root=/dev/mapper/cryptroot rw quiet"

cat > /mnt/root/nuit-stage2.sh <<'STAGE2'
#!/bin/bash
set -euo pipefail
STAGE2
# Stage-1 answers baked in: the quoted heredoc above cannot expand them,
# and stage 2 runs under `set -u` (anything unset would abort the install).
{
  printf 'USERNAME=%q\n' "$USERNAME"
  printf 'USER_PASS=%q\n' "$USER_PASS"
  printf 'HOSTNAME=%q\n' "$HOSTNAME"
  printf 'LOCALE=%q\n' "$LOCALE"
  printf 'LANG_VAL=%q\n' "$LANG_VAL"
  printf 'KEYMAP=%q\n' "$KEYMAP"
  printf 'TZ=%q\n' "$TZ"
  printf 'LUKS_HOOK=%q\n' "$LUKS_HOOK"
  printf 'ROOT_LINE=%q\n' "$ROOT_LINE"
} >> /mnt/root/nuit-stage2.sh
cat >> /mnt/root/nuit-stage2.sh <<'STAGE2B'

# Skel, helper scripts and artwork from the live image
cp -a /etc/skel/. /etc/skel/
cp -a /usr/local/bin/nuit-* /usr/local/bin/ 2>/dev/null || true
cp -a /usr/share/backgrounds/. /usr/share/backgrounds/ 2>/dev/null || true
mkdir -p /usr/share/plymouth/themes
cp -a /usr/share/plymouth/themes/NuitOS/. /usr/share/plymouth/themes/NuitOS/ 2>/dev/null || true

# Plymouth
cat > /etc/plymouth/plymouthd.conf <<'PLY'
[Daemon]
Theme=NuitOS
ShowDelay=0
PLY

# LightDM: slick greeter + autologin into the Hyprland session
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm.conf <<DM
[Seat:*]
greeter-session=lightdm-slick-greeter
user-session=hyprland
autologin-user=${USERNAME}
autologin-session=hyprland
DM

# Services
systemctl enable lightdm.service
systemctl enable NetworkManager.service
systemctl enable bluetooth.service || true
systemctl enable power-profiles-daemon.service || true

# Hostname / hosts
echo "${HOSTNAME}" > /etc/hostname
grep -q "127.0.1.1" /etc/hosts || echo "127.0.1.1 ${HOSTNAME}" >> /etc/hosts
sed -i "s/^127.0.1.1 .*/127.0.1.1 ${HOSTNAME}/" /etc/hosts

# Locale
grep -q "^${LOCALE}" /etc/locale.gen || echo "${LOCALE}" >> /etc/locale.gen
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen >/dev/null 2>&1
echo "LANG=${LANG_VAL}" > /etc/locale.conf

# Keymap
echo "KEYMAP=${KEYMAP}" > /etc/vconsole.conf

# Timezone + UTC clock
ln -sf /usr/share/zoneinfo/${TZ} /etc/localtime
hwclock --systohc --utc || true

# User (skel dotfiles land automatically) + policy config
if ! id ${USERNAME} &>/dev/null; then
  useradd -m -G wheel,audio,video,storage -s /bin/bash ${USERNAME}
  echo "${USERNAME}:${USER_PASS}" | chpasswd
fi
passwd -l root 2>/dev/null || true
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
grep -q '^%wheel ALL=(ALL:ALL) ALL' /etc/sudoers || echo '%wheel ALL=(ALL:ALL) ALL' >> /etc/sudoers

# Initramfs with plymouth (and LUKS encrypt hook when needed)
cat > /etc/mkinitcpio.conf <<MK
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block ${LUKS_HOOK} filesystems plymouth fsck)
COMPRESSION=(zstd)
MK
mkinitcpio -P >/dev/null 2>&1 || true

# Bootloader (systemd-boot)
bootctl --esp-path=/boot --boot-path=/boot install >/dev/null 2>&1 || true
mkdir -p /boot/loader /boot/loader/entries
cat > /boot/loader/loader.conf <<'LD'
default  nuitos.conf
timeout   3
console-mode max
editor    no
LD
cat > /boot/loader/entries/nuitos.conf <<ENT
title   Nuit OS
linux   /vmlinuz-linux
initrd  /intel-ucode.img
initrd  /amd-ucode.img
initrd  /initramfs-linux.img
options ${ROOT_LINE}
ENT
STAGE2B

chmod +x /mnt/root/nuit-stage2.sh
gum spin --spinner line --title "  Configuring system (user, boot, locale)…" -- \
  arch-chroot /mnt /bin/bash /root/nuit-stage2.sh
rm -f /mnt/root/nuit-stage2.sh
ok "System configured"

# ── Cleanup ──────────────────────────────────────────────────────────────────
info "Unmounting and cleaning up"
sync
umount -R /mnt || true
if [[ -n "$SWAP_PART" ]]; then
  swapoff -a || true
fi
if [[ "$LUKS_OPT" == *"LUKS2"* ]]; then
  cryptsetup close cryptroot || true
fi
ok "Unmounted"

# ── Done ─────────────────────────────────────────────────────────────────────
echo
gum style \
  --padding "1 4" \
  --border double \
  --border-foreground "$GREEN" \
  --foreground "$GREEN" \
  --bold \
  --align center \
  --width 60 \
  "Installation Complete"

card "${GREEN}NuitOS installed.${FG}

  ${DIM}user${FG}   ${USERNAME} ${DIM}·${FG} ${HOSTNAME}
  ${DIM}root${FG}   ${FS} ${LUKS_OPT:+· LUKS2 }${DIM}·${FG} systemd-boot
   ${DIM}desk${FG}   Hyprland ${DIM}·${FG} LightDM autologin

${DIM}Remove the installation media, then reboot."

echo
if gum confirm \
  --affirmative "Reboot" \
  --negative "Stay in live session" \
  --selected.foreground "$GREEN" \
  --unselected.foreground "$DIM" \
  "Reboot now?"; then
  systemctl reboot
else
  info "Reboot anytime with: systemctl reboot"
fi
