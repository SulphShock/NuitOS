// fastfetch -- system info, but make it pretty.

//  --------------------------------
//  NuitOS — fastfetch
//  Arch Linux + Hyprland + QuickShell
//  --------------------------------

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/nuitos.png",
        "type": "kitty",
        "height": 11,
        "padding": {
            "top": 3,
            "left": 1,
            "right": 4
        },
        "printRemaining": false
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": "~ ",
            "keyColor": "34"
        },
        "break"
    ]
}
